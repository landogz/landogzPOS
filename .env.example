# ═══════════════════════════════════════════
# PHARMAPOS / LANDOGZ POS - ENVIRONMENT
# ═══════════════════════════════════════════

APP_NAME="PharmaPOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── NODE IDENTITY ───────────────────────
# Options: cloud | local
NODE_TYPE=local
NODE_ID=1
# Fallback only (sync, CLI, or when no user context). For POS/transactions the branch
# and terminal are always taken from the logged-in account (user.branch_id). Cashiers
# must be assigned to a branch so transactions save to the correct branch and terminal.
BRANCH_ID=1
BRANCH_NAME="Branch 1 - Main"

# ─── LOCAL DATABASE (primary) ───────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pharmapos_local
DB_USERNAME=root
DB_PASSWORD=

# ─── CLOUD DATABASE (sync target, local node only) ───
CLOUD_DB_HOST=
CLOUD_DB_PORT=3306
CLOUD_DB_DATABASE=pharmapos_cloud
CLOUD_DB_USERNAME=
CLOUD_DB_PASSWORD=

# ─── CLOUD API (alternative sync mode) ───
CLOUD_API_URL=https://yourdomain.com/api/v1
CLOUD_API_TOKEN=

# ─── SYNC SETTINGS ───────────────────────
# Options: api | direct_db
SYNC_MODE=api
SYNC_INTERVAL=300
SYNC_RETRY_ATTEMPTS=3
SYNC_CONFLICT_RESOLUTION=server_wins

# ─── POS TERMINAL SETTINGS ───────────────
POS_LAN_IP=192.168.1.100
POS_LAN_PORT=8000
RECEIPT_PRINTER_TYPE=thermal_80mm
CASH_DRAWER_ENABLED=true
BARCODE_SCANNER_MODE=usb

# ─── BIR SETTINGS ────────────────────────
BIR_TIN=
BIR_ACCREDITATION_NUMBER=
BIR_OR_SERIES_START=
BIR_OR_SERIES_END=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── MAIL ────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"
# Where to send quote request form submissions (e.g. rolan.benavidez@gmail.com)
QUOTE_REQUEST_EMAIL=
TERMINAL_API_KEY=

# ─── SEMAPHORE SMS / OTP (Philippines) ───
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE
SEMAPHORE_OTP_TTL=300
SEMAPHORE_OTP_LENGTH=6
# Optional: custom message; use {otp} as placeholder
# SEMAPHORE_OTP_MESSAGE="Your Landogz POS code is {otp}. Valid for 5 minutes."

# ─── SUPER ADMIN LOGIN OTP ───────────────
# Enable OTP for super_admin login (true|false)
SUPER_ADMIN_OTP_ENABLED=false
# Channel: sms (Semaphore) or email (Laravel Mail). SMS requires user phone_number.
OTP_CHANNEL=sms
OTP_TTL=300
OTP_LENGTH=6

# ─── VITE (POS / Dashboard) ──────────────
VITE_APP_NAME="${APP_NAME}"
VITE_LOCAL_API_URL=http://192.168.1.100:8000/api/v1
VITE_CLOUD_API_URL=https://yourdomain.com/api/v1
